ANAM_API_KEY=
ANAM_AVATAR_ID=edf6fdcb-acab-44b8-b974-ded72665ee26
ANAM_AVATAR_MODEL=cara-4
DEEPGRAM_API_KEY=
THINK_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
# Flux is Deepgram's turn-taking-aware STT/TTS pair, built for voice agents (model-integrated
# end-of-turn detection on the STT side, turn-based lifecycle on the TTS side). Set these to
# aura-2-thalia-en / nova-3 instead to fall back to the older, non-Flux voices/models.
SPEAK_MODEL=flux-kit-en
LISTEN_MODEL=flux-general-en
# Optional Flux STT end-of-turn tuning (only applies when LISTEN_MODEL starts with "flux"):
# FLUX_EOT_THRESHOLD=0.7
# FLUX_EAGER_EOT_THRESHOLD=
# FLUX_EOT_TIMEOUT_MS=5000
PORT=4400
